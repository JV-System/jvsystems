rules_version = '2';

// BarberPro Turnos - reglas de seguridad de Firestore.
//
//  - config/main      datos de la barbería (nombre, horarios, precio, cobros, cierres): los ve cualquiera, los edita solo el dueño.
//  - slots/{fecha_hora}  marca de "horario ocupado": pública, trae solo fecha y hora (ningún dato de personas).
//                        Cualquiera puede crearla UNA vez: si el documento ya existe no se puede pisar, así dos personas
//                        no reservan el mismo horario. Solo el dueño la borra (al cancelar).
//  - bookings/{id}    la reserva completa (nombre, teléfono, mail): el cliente solo puede CREARLA; leerla es del dueño.
//  - clients/{uid}    perfil del cliente (nombre, apodo, teléfono, mail, foto). El cliente entra con mail y contraseña (Firebase
//                     Authentication) y solo puede ver y editar el suyo; el dueño los ve todos.
//  - clients/{uid}/turnos/{id}  copia resumida de cada reserva del cliente (fecha, hora, precio, estado) para "Tus turnos".
//  - debtFlags/{key}  aviso de "tiene un saldo pendiente": se consulta de a uno (get), no se puede listar.
//  - debts/{key}      detalle de saldos pendientes: solo el dueño.
//
// El dueño es el usuario de Firebase Authentication cuyo uid figura en isOwner().

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid in ['RQIEHKxHKwPAZXguUzxO2vd6s8k1'];
    }

    function signedIn() {
      return request.auth != null;
    }

    // empleados: el dueño crea un documento staff/{uid} por cada uno (uid de su usuario) con el barbero al que corresponden
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffBarber() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.barberId;
    }

    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    function validDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTime(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // fecha de hoy en Argentina (UTC-3) como 'AAAA-MM-DD'
    function hoyAR() {
      let t = request.time - duration.value(3, 'h');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    // 'AAAA-MM-DD HH:MM' de un instante, en hora de Argentina
    function dtAR(ts) {
      let t = ts - duration.value(3, 'h');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()) + ' ' + pad2(t.hours()) + ':' + pad2(t.minutes());
    }

    function minsOf(time) {
      return int(time[0:2]) * 60 + int(time[3:5]);
    }

    function bookingPath(bid) {
      return /databases/$(database)/documents/bookings/$(bid);
    }

    // id del horario ocupado: fecha + hora (+ barbero si la reserva es con un barbero del equipo)
    function slotId(d) {
      return d.date + '_' + d.time.replace(':', '') + ('barber' in d ? '_' + d.barber : '');
    }

    function bookingSlotId(d) {
      return d.date + '_' + d.time.replace(':', '') + ('barberId' in d ? '_' + d.barberId : '');
    }

    function validBarberId(v) {
      return v is string && v.matches('^[a-z0-9]{1,24}$');
    }

    // ---------- empleados ----------
    match /staff/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // ---------- foto de perfil de los barberos ----------
    // pública (la ve el cliente al elegir con quién cortarse); la cambia el dueño o el propio empleado en su barbero
    match /barbers/{id} {
      allow read: if true;
      allow create, update: if (isOwner() || (isStaff() && staffBarber() == id))
                            && request.resource.data.keys().hasOnly(['photo'])
                            && isStr(request.resource.data.photo, 60000)
                            && request.resource.data.photo.matches('^data:image/jpeg;base64,.*');
      allow delete: if isOwner() || (isStaff() && staffBarber() == id);
    }

    // ---------- datos del negocio ----------
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---------- horarios ocupados ----------
    match /slots/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['date', 'time', 'bid', 'barber'])
                    && request.resource.data.keys().hasAll(['date', 'time', 'bid'])
                    && (!('barber' in request.resource.data) || validBarberId(request.resource.data.barber))
                    && validDate(request.resource.data.date)
                    && validTime(request.resource.data.time)
                    && isStr(request.resource.data.bid, 40)
                    && id == slotId(request.resource.data)
                    && getAfter(bookingPath(request.resource.data.bid)).data.date == request.resource.data.date
                    && getAfter(bookingPath(request.resource.data.bid)).data.time == request.resource.data.time;
      allow update: if false;
      // el dueño, o el cliente dueño de esa reserva en el mismo lote en que la cancela
      allow delete: if isOwner()
                    || (isStaff() && resource.data.get('barber', '') == staffBarber())
                    || (signedIn()
                        && get(bookingPath(resource.data.bid)).data.cid == request.auth.uid
                        && (getAfter(bookingPath(resource.data.bid)).data.status == 'cancelled'
                            // o la reserva se cambió de día y este horario ya no es el suyo
                            || (getAfter(bookingPath(resource.data.bid)).data.get('rescheduled', 0) == 1
                                && bookingSlotId(getAfter(bookingPath(resource.data.bid)).data) != id)));
    }

    // ---------- reservas ----------
    match /bookings/{bid} {
      allow read: if isOwner() || (isStaff() && resource.data.barberId == staffBarber());
      allow delete: if isOwner();
      // el dueño cambia lo que quiera; el cliente solo puede CANCELAR su propia reserva confirmada (y no una ya pasada).
      // lateCancel lo fija la regla: es true solo si cancela el mismo día del turno (ahí se cobra el 50% de seña).
      allow update: if isOwner()
                    || (signedIn() && resource.data.cid == request.auth.uid
                        && resource.data.status == 'confirmed'
                        && resource.data.date >= hoyAR()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lateCancel'])
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.lateCancel == (resource.data.date == hoyAR()))
                    || informsDeposit() || informsBalance() || staffEdits() || reschedules();
      allow create: if signedIn() && validBooking(bid, request.resource.data) && request.resource.data.cid == request.auth.uid;
    }

    // el cliente avisa que pagó (por transferencia o Mercado Pago). Solo pasa de "pendiente" a "informado";
    // confirmar el pago ("pagado") lo hace únicamente el dueño.
    function ownsBooking() {
      return signedIn() && resource.data.cid == request.auth.uid;
    }
    // un empleado puede completar y cobrar los turnos de SU barbero (no cancelarlos ni tocar nada más)
    function staffEdits() {
      return isStaff() && resource.data.get('barberId', '') == staffBarber()
          && resource.data.status in ['confirmed', 'completed']
          && request.resource.data.status in ['confirmed', 'completed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paid', 'depositState', 'balanceState',
                                                                                  'balanceMethod', 'seenByOwner', 'reminded']);
    }

    // cambio de día: una sola vez por reserva y hasta 24 horas antes del turno; la seña pasa al nuevo horario (el cliente
    // crea el horario nuevo y libera el viejo en el mismo lote)
    function reschedules() {
      return ownsBooking() && resource.data.status == 'confirmed'
          && resource.data.get('rescheduled', 0) == 0 && resource.data.get('walkIn', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'rescheduled', 'originalDate', 'originalTime'])
          && request.resource.data.rescheduled == 1
          && request.resource.data.originalDate == resource.data.date && request.resource.data.originalTime == resource.data.time
          && validDate(request.resource.data.date) && validTime(request.resource.data.time)
          && request.resource.data.date >= hoyAR()
          && resource.data.date + ' ' + resource.data.time >= dtAR(request.time + duration.value(24, 'h'))
          && existsAfter(/databases/$(database)/documents/slots/$(bookingSlotId(request.resource.data)));
    }

    function informsDeposit() {
      return ownsBooking() && resource.data.status == 'confirmed'
          && resource.data.get('depositState', 'pending') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['depositState', 'payMethod'])
          && request.resource.data.depositState == 'informed'
          && request.resource.data.payMethod in ['transfer', 'mp'];
    }
    function informsBalance() {
      return ownsBooking() && resource.data.status in ['confirmed', 'completed']
          && resource.data.get('balanceState', 'pending') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceState', 'balanceMethod'])
          && request.resource.data.balanceState == 'informed'
          && request.resource.data.balanceMethod in ['transfer', 'mp'];
    }

    // seña y saldo: opcionales al crear (reservas viejas), pero si vienen tienen que ser coherentes
    // orden de llegada: turno de HOY, que empieza en los próximos minutos que permita el local, con el pago completo (sin seña)
    function validWalkIn(d) {
      return d.walkIn == true && d.get('deposit', -1) == 0 && d.get('depositState', 'x') == 'paid' && d.get('balanceState', 'x') == 'pending'
          && d.date == hoyAR()
          && (exists(/databases/$(database)/documents/config/main) ? get(/databases/$(database)/documents/config/main).data.get('walkInMinutes', 90) : 90) > 0
          && minsOf(d.time) >= (request.time - duration.value(3, 'h')).hours() * 60 + (request.time - duration.value(3, 'h')).minutes() - 5
          && minsOf(d.time) <= (request.time - duration.value(3, 'h')).hours() * 60 + (request.time - duration.value(3, 'h')).minutes()
                               + (exists(/databases/$(database)/documents/config/main) ? get(/databases/$(database)/documents/config/main).data.get('walkInMinutes', 90) : 90) + 5
          && !('balanceMethod' in d) && !('depositRefunded' in d);
    }

    function validPayFields(d) {
      return ('walkIn' in d) ? validWalkIn(d) : validPayFieldsNormal(d);
    }

    function validPayFieldsNormal(d) {
      return (!('deposit' in d) || (d.deposit is number && d.deposit >= 0 && d.deposit <= d.price
                                     && d.get('depositState', 'x') == (d.deposit > 0 ? 'pending' : 'paid')
                                     && d.get('balanceState', 'x') == 'pending'
                                     && d.deposit * 100 + 100 >= d.price * (exists(/databases/$(database)/documents/config/main)
                                          ? get(/databases/$(database)/documents/config/main).data.get('depositPercent', 50) : 50)))
          && (!('depositState' in d) || 'deposit' in d)
          && (!('balanceState' in d) || 'deposit' in d)
          && !('balanceMethod' in d) && !('depositRefunded' in d);
    }

    function validBooking(bid, d) {
      return d.keys().hasOnly(['id', 'name', 'lastname', 'nickname', 'phone', 'email', 'date', 'time', 'price',
                               'debtCharged', 'payMethod', 'paid', 'status', 'createdAt', 'seenByOwner', 'clientKey', 'cid',
                               'deposit', 'depositState', 'balanceState', 'barberId', 'barberName', 'walkIn'])
          && d.keys().hasAll(['id', 'name', 'lastname', 'phone', 'email', 'date', 'time', 'price',
                              'debtCharged', 'payMethod', 'paid', 'status', 'createdAt', 'clientKey', 'cid'])
          && d.id == bid
          && isStr(d.name, 60) && d.name.size() > 0
          && isStr(d.lastname, 60) && d.lastname.size() > 0
          && (!('nickname' in d) || isStr(d.nickname, 30))
          && isStr(d.phone, 40) && d.phone.size() >= 6
          && isStr(d.email, 120) && d.email.matches('.+@.+[.].+')
          && validDate(d.date) && validTime(d.time)
          && d.price is number && d.price > 0 && d.price <= 10000000
          && (!exists(/databases/$(database)/documents/config/main)
              || get(/databases/$(database)/documents/config/main).data.price == d.price)
          && d.debtCharged is number && d.debtCharged >= 0 && d.debtCharged <= d.price
          && d.payMethod in ['local', 'transfer', 'mp']
          && d.paid == false
          && d.status == 'confirmed'
          && d.createdAt is number
          && (!('seenByOwner' in d) || d.seenByOwner == false)
          && isStr(d.clientKey, 80)
          && isStr(d.cid, 128)
          && validPayFields(d)
          && (!('barberId' in d) || (validBarberId(d.barberId) && isStr(d.get('barberName', ''), 60)))
          && (!('barberName' in d) || 'barberId' in d)
          // la reserva tiene que venir junto con la marca de horario ocupado (se escriben en un mismo lote)
          && existsAfter(/databases/$(database)/documents/slots/$(bookingSlotId(d)));
    }

    // ---------- perfiles de clientes ----------
    // la foto de perfil es un JPEG chico guardado como texto (data:image/jpeg;base64,...)
    function validClient(d) {
      return d.keys().hasOnly(['name', 'lastname', 'nickname', 'phone', 'email', 'photo'])
          && d.keys().hasAll(['name', 'lastname', 'phone', 'email'])
          && isStr(d.name, 60) && d.name.size() > 0
          && isStr(d.lastname, 60) && d.lastname.size() > 0
          && (!('nickname' in d) || isStr(d.nickname, 30))
          && isStr(d.phone, 40) && d.phone.size() >= 6
          && isStr(d.email, 120) && d.email.matches('.+@.+[.].+')
          && (!('photo' in d) || (isStr(d.photo, 60000) && d.photo.matches('^data:image/jpeg;base64,.*')));
    }

    match /clients/{id} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == id);
      allow create: if signedIn() && request.auth.uid == id && validClient(request.resource.data);
      // se puede corregir todo menos el mail (que es el usuario)
      allow update: if signedIn() && request.auth.uid == id && validClient(request.resource.data)
                    && request.resource.data.email == resource.data.email;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == id);
    }

    // ---------- "mis turnos" del cliente ----------
    // copia resumida de cada reserva (sin nombre, teléfono ni mail) bajo el perfil del cliente: el cliente la crea junto con la
    // reserva y solo el dueño la actualiza (estado: confirmado / realizado / cancelado, pagado). La lee ese cliente o el dueño.
    function validTurno(tid, d) {
      return d.keys().hasOnly(['id', 'date', 'time', 'price', 'debtCharged', 'payMethod', 'paid', 'status', 'createdAt',
                               'deposit', 'depositState', 'balanceState', 'barberId', 'barberName', 'walkIn'])
          && d.keys().hasAll(['id', 'date', 'time', 'price', 'debtCharged', 'payMethod', 'paid', 'status', 'createdAt'])
          && d.id == tid
          && validDate(d.date) && validTime(d.time)
          && d.price is number && d.price > 0 && d.price <= 10000000
          && d.debtCharged is number && d.debtCharged >= 0 && d.debtCharged <= d.price
          && d.payMethod in ['local', 'transfer', 'mp']
          && d.paid == false
          && d.status == 'confirmed'
          && d.createdAt is number
          && (!('deposit' in d) || (d.deposit is number && d.deposit >= 0 && d.deposit <= d.price
                                     && d.get('depositState', 'x') == (d.deposit > 0 ? 'pending' : 'paid')
                                     && d.get('balanceState', 'x') == 'pending'));
    }

    match /clients/{id}/turnos/{tid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == id);
      allow create: if isOwner()
                    || (signedIn() && request.auth.uid == id && validTurno(tid, request.resource.data)
                        && existsAfter(/databases/$(database)/documents/bookings/$(tid)));
      allow update: if isOwner()
                    || (signedIn() && request.auth.uid == id && resource.data.status == 'confirmed'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'cancelled'
                        && getAfter(bookingPath(tid)).data.status == 'cancelled')
                    // el cliente avisa un pago: la copia refleja lo mismo que la reserva
                    || (signedIn() && request.auth.uid == id && resource.data.get('depositState', 'pending') == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['depositState', 'payMethod'])
                        && request.resource.data.depositState == 'informed' && request.resource.data.payMethod in ['transfer', 'mp']
                        && getAfter(bookingPath(tid)).data.depositState == 'informed')
                    || (signedIn() && request.auth.uid == id && resource.data.get('balanceState', 'pending') == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceState', 'balanceMethod'])
                        && request.resource.data.balanceState == 'informed' && request.resource.data.balanceMethod in ['transfer', 'mp']
                        && getAfter(bookingPath(tid)).data.balanceState == 'informed')
                    || (signedIn() && request.auth.uid == id && resource.data.status == 'confirmed' && resource.data.get('rescheduled', 0) == 0
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'rescheduled'])
                        && request.resource.data.rescheduled == 1
                        && getAfter(bookingPath(tid)).data.get('rescheduled', 0) == 1
                        && getAfter(bookingPath(tid)).data.date == request.resource.data.date
                        && getAfter(bookingPath(tid)).data.time == request.resource.data.time)
                    || (isStaff() && get(bookingPath(tid)).data.get('barberId', '') == staffBarber()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paid', 'depositState', 'balanceState', 'balanceMethod'])
                        && request.resource.data.status in ['confirmed', 'completed'] && resource.data.status in ['confirmed', 'completed']);
      allow delete: if isOwner();
    }

    // ---------- saldos pendientes ----------
    // La clave de un saldo es el id de la cuenta del cliente. Lo crea el dueño al cancelar un turno del mismo día o el propio
    // cliente cuando cancela el mismo día (la regla verifica en la reserva que de verdad fue una cancelación tardía).
    function validLateDebt(key, d) {
      return signedIn() && request.auth.uid == key && isStr(d.bid, 40)
          && getAfter(bookingPath(d.bid)).data.cid == key
          && getAfter(bookingPath(d.bid)).data.status == 'cancelled'
          && getAfter(bookingPath(d.bid)).data.lateCancel == true;
    }

    match /debtFlags/{key} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == key);
      allow list: if isOwner();
      allow delete: if isOwner() || isStaff();
      allow create: if isOwner() || (request.resource.data.keys().hasOnly(['since', 'bid']) && validLateDebt(key, request.resource.data));
      allow update: if isOwner()
                    || (signedIn() && request.auth.uid == key
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chargedBy'])
                        && (
                          // el saldo se suma a un turno nuevo (una sola vez)
                          (resource.data.get('chargedBy', null) == null && isStr(request.resource.data.chargedBy, 40))
                          // o ese turno se cancela y el saldo vuelve a quedar pendiente
                          || (resource.data.get('chargedBy', null) != null && request.resource.data.chargedBy == null
                              && getAfter(bookingPath(resource.data.chargedBy)).data.cid == key
                              && getAfter(bookingPath(resource.data.chargedBy)).data.status == 'cancelled')));
    }

    match /debts/{key} {
      allow read, update: if isOwner();
      allow delete: if isOwner() || isStaff();
      allow create: if isOwner()
                    || (request.resource.data.keys().hasOnly(['name', 'lastname', 'phone', 'since', 'bid'])
                        && isStr(request.resource.data.name, 60) && isStr(request.resource.data.lastname, 60)
                        && isStr(request.resource.data.phone, 40) && request.resource.data.since is number
                        && validLateDebt(key, request.resource.data));
    }
  }
}
